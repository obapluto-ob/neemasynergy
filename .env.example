# Copy this to .env for local dev — NEVER commit .env to git

# Admin password SHA-256 hash
# Generate: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('yourpassword').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Cloudinary (free at cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JSONBin.io (free at jsonbin.io) — for storing site settings
JSONBIN_URL=
JSONBIN_API_KEY=
